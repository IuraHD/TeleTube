TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Cloud API by default. Set both values to use a separately running local Bot API.
USE_LOCAL_API=false
LOCAL_API_SERVER=http://127.0.0.1:8081
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=2
LOG_LEVEL=INFO
# Optional private group cache. Get the ID with /chatid inside the group.
CACHE_CHAT_ID=
CACHE_DB_PATH=data/cache.sqlite3
