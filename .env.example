TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Optional: private group ID from /chatid. Leave blank to disable caching.
CACHE_CHAT_ID=

# Optional runtime settings.
MAX_CONCURRENT_DOWNLOADS=2
LOG_LEVEL=INFO

# Optional local Bot API for larger uploads; run the server separately.
USE_LOCAL_API=false
LOCAL_API_SERVER=http://host.docker.internal:8081
