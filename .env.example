# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Local Bot API Server (Enable for 2GB file uploads instead of 50MB)
# USE_LOCAL_API is now set by the batch files
# Set USE_LOCAL_API=true for local server with 2GB limit
# Set USE_LOCAL_API=false for standard Telegram API with 50MB limit
LOCAL_API_SERVER=http://localhost:8081

# Local API Server Credentials (Required for Local API Server)
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# File Upload Settings
# MAX_FILE_SIZE_MB is now set by the batch files
# Local API: 2GB max (2000MB), Standard API: 50MB max

# GPU Acceleration Settings (for faster video processing)
# Set to true to enable NVIDIA GPU acceleration (requires compatible GPU)
USE_GPU_ACCELERATION=true
GPU_ENCODER=h264_nvenc

# FFmpeg Configuration
# Leave empty to use system FFmpeg, or specify path to FFmpeg binary
# Windows: ffmpeg\ (if FFmpeg is in package)
# Linux/Mac: /usr/bin/ffmpeg (or leave empty for system default)
FFMPEG_PATH=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Advanced Settings (Optional)
# PRIORITIZE_SPEED=true
# MAX_CONCURRENT_DOWNLOADS=4
